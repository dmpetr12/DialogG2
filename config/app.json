{
    "schemaVersion": 1,
    "modbus": {
        "relay": {
            "port": "/dev/rs485_relay",
            "baudRate": 9600,
            "parity": "none",
            "dataBits": 8,
            "stopBits": 1,
            "timeoutMs": 250,
            "retries": 0,
            "busOfflineFailureThreshold": 3
        },
        "metering": {
            "port": "/dev/rs485_metering",
            "baudRate": 9600,
            "parity": "none",
            "dataBits": 8,
            "stopBits": 1,
            "timeoutMs": 250,
            "retries": 0,
            "busOfflineFailureThreshold": 3
        },
        "tcp": {
            "enabled": true,
            "bind": "0.0.0.0",
            "port": 502,
            "serverAddress": 1
        }
    },
    "web": {
        "enabled": true,
        "bind": "0.0.0.0",
        "port": 8080,
        "root": "web"
    }
}
